# Copy to `.env` and/or `.env.local` in this directory.
# Loads `.env` first, then `.env.local` (overrides). Required: ETHEREUM_PRIVATE_KEY, MONGODB_URI, ADMIN_API_KEY
#
# Local Mongo with Docker (repo root): docker compose up -d
# MONGODB_URI=mongodb://127.0.0.1:27017/

# On-chain adapter: flow (default) | evm
# BLOCKCHAIN_ADAPTER=flow

# Network
NETWORK=mainnet
# Optional: pin chain when using ETHEREUM_RPC_FALLBACK_URLS (must match every RPC). Base=8453, Sepolia=11155111
# ETHEREUM_CHAIN_ID=8453
# Primary RPC (Base mainnet default). Use Alchemy/Infura in production.
ETHEREUM_RPC_URL=https://mainnet.base.org
# Optional: comma-separated fallback RPCs when primary returns errors/timeouts
# ETHEREUM_RPC_FALLBACK_URLS=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY,https://base.meowrpc.com
ETHEREUM_PRIVATE_KEY=your_base_mainnet_private_key_here

# Price symbol (Bybit spot ticker)
PRICE_SYMBOL=FLOWUSDT

# LineFutures contract — set after deploy; required for full prediction/futures flow
FUTURES_CONTRACT_ADDRESS=0xDc2C6CD0751a83973c97aB52f2FaD25009a9B1D1

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DATABASE=sketchflow
# Optional: comma-separated position IDs to never attempt to close
# SKIP_POSITION_IDS=4,5

# API server
PORT=3001
API_HOST=0.0.0.0

# Bybit WebSocket (public spot tickers)
BYBIT_WSS_URL=wss://stream.bybit.com/v5/public/spot

# Admin — required; use a long random secret in production
ADMIN_API_KEY=your_secure_admin_api_key_here

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# USDC ↔ ETH display rate for predict UI (matches frontend NEXT_PUBLIC_ETH_USD_RATE if set)
ETH_USD_RATE=3000

# Flow fee sponsorship (optional “paymaster”): separate account pays tx fees; user still signs stake + authz
# Requires BLOCKCHAIN_ADAPTER=flow, FLOW_LINE_FUTURES_ADDRESS (or FUTURES_CONTRACT_ADDRESS), and a funded sponsor key.
# Cadence must match frontend open/batch txs (same LineFutures + token import addresses).
# FLOW_SPONSOR_ENABLED=true
# FLOW_SPONSOR_ADDRESS=0x...
# FLOW_SPONSOR_PRIVATE_KEY=hex_without_0x
# FLOW_SPONSOR_KEY_ID=0
# Optional shared secret for POST /api/flow/sponsor-sign (browser sends x-flow-sponsor-key if set)
# FLOW_SPONSOR_API_KEY=
# Optional: override core imports if frontend uses NEXT_PUBLIC_FLOW_* token overrides (must match)
# FLOW_FUNGIBLE_TOKEN_ADDRESS=
# FLOW_TOKEN_ADDRESS=
# FLOW_SPONSOR_RATE_LIMIT_MAX=60

# Monitoring
LOG_LEVEL=info
# Optional: Slack/Discord webhook for alerts
ALERT_WEBHOOK_URL=
