# Copy to `.env.local` for local dev (Next.js reads `.env.local` automatically).

# Flow — LineFutures deployment (16-hex account address, same network as below)
NEXT_PUBLIC_FLOW_LINE_FUTURES_ADDRESS=

# Flow network: testnet | mainnet (defaults access node + wallet discovery)
NEXT_PUBLIC_FLOW_NETWORK=testnet

# Optional overrides (defaults match canonical testnet/mainnet)
# NEXT_PUBLIC_FLOW_ACCESS_NODE=https://rest-testnet.onflow.org
# NEXT_PUBLIC_FLOW_DISCOVERY_WALLET=https://fcl-discovery.onflow.org/testnet/authn
# NEXT_PUBLIC_FLOW_FUNGIBLE_TOKEN_ADDRESS=
# NEXT_PUBLIC_FLOW_TOKEN_ADDRESS=

# Backend API (must match backend PORT=3001)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Fee sponsorship (optional): when backend enables FLOW_SPONSOR_ENABLED, predict uses a separate payer.
# If the server sets FLOW_SPONSOR_API_KEY, set the same value here so the browser can call /api/flow/sponsor-sign.
# NEXT_PUBLIC_FLOW_SPONSOR_API_KEY=
# Set to true to force user-paid fees even if the API advertises sponsorship.
# NEXT_PUBLIC_FLOW_SPONSOR_DISABLED=true

# Pitch page walkthrough video
# NEXT_PUBLIC_PITCH_WALKTHROUGH_VIDEO_URL=https://example.com/SketchFlow-Walkthrough.mp4
